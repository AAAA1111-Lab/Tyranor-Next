//!DESC CuNNy-4x24-NVL native 2x reconstruction
//!HOOK MAIN
//!BIND MAIN
//!BIND B0
//!BIND B1
//!BIND B2
vec4 hook(){ ivec2 pixel=ivec2(gl_FragCoord.xy); ivec2 p=pixel/2;
int phase=(1-(pixel.y%2))*2+(pixel.x%2); vec3 base=MAIN_tex(vPos).rgb;
vec3 residual=vec3(texelFetch(u_B0,p,0)[phase],texelFetch(u_B1,p,0)[phase],texelFetch(u_B2,p,0)[phase]);
return vec4(base+residual,1.0);}
