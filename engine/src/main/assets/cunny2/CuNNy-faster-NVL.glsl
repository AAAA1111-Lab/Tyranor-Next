//!DESC CuNNy-faster-NVL native 2x reconstruction
//!HOOK MAIN
//!BIND MAIN
//!BIND B0
vec4 hook(){ ivec2 pixel=ivec2(gl_FragCoord.xy); ivec2 p=pixel/2;
int phase=(1-(pixel.y%2))*2+(pixel.x%2); vec3 base=MAIN_tex(vPos).rgb;
float residual=texelFetch(u_B0,p,0)[phase];
float y=dot(base,vec3(0.299,0.587,0.114)); return vec4(base+vec3(clamp(y+residual,0.0,1.0)-y),1.0);}
